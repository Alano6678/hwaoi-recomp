{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "HWAoI Recomp",
  "repo": "Alano6678/hwaoi-recomp",
  "system": {
    "windows": {
      "version": "10",
      "graphics": {"vulkan": "1.3"}
    }
  },
  "inputs": [
    {
      "id": "nup",
      "label": "Your Hyrule Warriors: Age of Imprisonment .nup",
      "role": "game",
      "formats": [{"type": "file", "extensions": ["nup"]}],
      "check": {"nup_build_id": "659cb288b5c5b2b49853add616c0d5bf4ea4e1ba"}
    },
    {
      "id": "dlc",
      "label": "Your DLC dump (.nup), if you have it",
      "role": "dlc",
      "optional": true,
      "formats": [{"type": "file", "extensions": ["nup"]}]
    }
  ],
  "prepare": {
    "program": ["HWAoI-Compiler.exe"],
    "args": ["cli", "prepare", "--game", "{input:nup}", "--out", "{install}/game", "--dlc={input:dlc}"],
    "label": "Building the game for this PC from your copy",
    "done": ["{install}/game/hwaoi-compiler.json"]
  },
  "start": {
    "program": ["HWAoI-Compiler.exe"],
    "args": ["play", "--game-dir", "{install}/game", "--game={input:nup}"]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [{"path": "{install}/game/work/build/hwaoi196608/hwaoi.ini"}],
      "new": {"output_res": "1920x1080", "fps_limit": "60", "render_scale": "100"}
    }
  ],
  "settings": [
    {
      "id": "output_res",
      "label": "Game resolution",
      "group": "Display",
      "choices": [
        {"label": "720p", "set": {"output_res": "1280x720"}},
        {"label": "1080p", "set": {"output_res": "1920x1080"}},
        {"label": "1440p", "set": {"output_res": "2560x1440"}},
        {"label": "4K", "set": {"output_res": "3840x2160"}}
      ],
      "defaults": {"output_res": "1920x1080"}
    },
    {
      "id": "fps_limit",
      "label": "Frame rate",
      "group": "Display",
      "choices": [
        {"label": "30 FPS", "set": {"fps_limit": "30"}},
        {"label": "60 FPS", "set": {"fps_limit": "60"}}
      ],
      "defaults": {"fps_limit": "60"}
    },
    {
      "id": "render_scale",
      "label": "3D rendering",
      "group": "Display",
      "choices": [
        {"label": "Native", "set": {"render_scale": "100"}},
        {"label": "Game default", "set": {"render_scale": "game"}}
      ],
      "defaults": {"render_scale": "100"}
    }
  ]
}
