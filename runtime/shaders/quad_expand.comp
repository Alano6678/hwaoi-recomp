// Original index expansion, dispatched with the GPU-converted quad count.
#version 450
layout(local_size_x=64) in;
layout(set=0,binding=1,std430) readonly buffer Header { uint words[]; } src;
layout(set=0,binding=2,std430) writeonly buffer Indices { uint words[]; } dst;
void main() {
    uint q=gl_GlobalInvocationID.x;
    if(src.words[8]!=0u || q>=(src.words[9]&~3u)/4u) return;
    uint v=src.words[11]+q*4u,k=q*6u;
    dst.words[k]=v; dst.words[k+1u]=v+1u; dst.words[k+2u]=v+2u;
    dst.words[k+3u]=v; dst.words[k+4u]=v+2u; dst.words[k+5u]=v+3u;
}
