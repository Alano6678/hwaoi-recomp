diff --git a/ryujinx/src/Ryujinx.Graphics.Shader/Translation/HwaoiPrivateRegisters.cs b/ryujinx/src/Ryujinx.Graphics.Shader/Translation/HwaoiPrivateRegisters.cs
new file mode 100644
index 0000000..1f689f5
--- /dev/null
+++ b/ryujinx/src/Ryujinx.Graphics.Shader/Translation/HwaoiPrivateRegisters.cs
@@ -0,0 +1,132 @@
+// HWAoI private lowering protocol. Original adapter/probes; no game content.
+using Ryujinx.Graphics.Shader.Decoders;
+using Ryujinx.Graphics.Shader.IntermediateRepresentation;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using static Ryujinx.Graphics.Shader.IntermediateRepresentation.OperandHelper;
+
+namespace Ryujinx.Graphics.Shader.Translation
+{
+    public static class HwaoiPrivateRegisters
+    {
+        private const ulong Marker = 0x5c98a00000070000UL;
+        private const ulong VariableBits = 0xffUL | (0xfUL << 8) | (0xffUL << 20);
+
+        internal static bool TryDecodeMove(ulong opcode, TranslationFlags flags, out int destination, out int source)
+        {
+            destination = source = 0;
+            if (((opcode >> 44) & 15) != 10) return false;
+            if (!flags.HasFlag(TranslationFlags.HwaoiPrivateRegisters))
+                throw new InvalidOperationException("HWAoI private register MOV requires hwaoi_ir_banks=1");
+            // Only the exact PT, non-inverted, zero-quadmask private MOV encoding
+            // is recognized. Do not reinterpret arbitrary Maxwell mode bits.
+            if ((opcode & ~VariableBits) != Marker)
+                throw new InvalidOperationException("Malformed HWAoI private register MOV");
+            int destinationBank = (int)((opcode >> 8) & 3), sourceBank = (int)((opcode >> 10) & 3);
+            if (destinationBank > 2 || sourceBank > 2)
+                throw new InvalidOperationException("HWAoI private register bank must be 0, 1 or 2");
+            destination = destinationBank * 256 + (int)(opcode & 255);
+            source = sourceBank * 256 + (int)((opcode >> 20) & 255);
+            return true;
+        }
+
+        private static ulong Encode(int destinationBank, int destination, int sourceBank, int source) =>
+            Marker | (ulong)(uint)destination | ((ulong)(uint)destinationBank << 8) |
+            ((ulong)(uint)sourceBank << 10) | ((ulong)(uint)source << 20);
+
+        // Pure translation/IR tests, exposed only to the command-line probe.
+        public static string Probe()
+        {
+            int checks = 0;
+            void Check(bool value, string reason)
+            {
+                checks++;
+                if (!value) throw new InvalidOperationException("IR-bank probe: " + reason);
+            }
+            void Reject(ulong instruction, TranslationFlags flags)
+            {
+                bool rejected = false;
+                try { TryDecodeMove(instruction, flags, out _, out _); }
+                catch (InvalidOperationException) { rejected = true; }
+                Check(rejected, "private encoding accepted without exact feature/shape");
+            }
+
+            Check(RegisterConsts.GprsCount == 768 && RegisterConsts.TotalCount == 779, "IR capacity");
+            Check(RegisterConsts.RegisterZeroIndex == 255, "architectural RZ changed");
+            Check(Register(255, RegisterType.Gpr).Type == OperandType.Constant, "bank0 RZ is not zero");
+            Check(Register(511, RegisterType.Gpr).Type == OperandType.Register, "bank1 register255 became RZ");
+            Check(Register(767, RegisterType.Gpr).GetRegister().Index == 767, "bank2 register255 lost");
+            int[] bytes = {0, 63, 64, 127, 128, 191, 192, 254, 255};
+            foreach (int db in Enumerable.Range(0, 3)) foreach (int sb in Enumerable.Range(0, 3))
+            foreach (int d in bytes) foreach (int s in bytes)
+            {
+                Check(TryDecodeMove(Encode(db, d, sb, s), TranslationFlags.HwaoiPrivateRegisters,
+                                    out int destination, out int source) &&
+                      destination == db * 256 + d && source == sb * 256 + s, "bank move mapping");
+            }
+            Reject(Encode(1, 255, 0, 1), TranslationFlags.None);
+            Reject(Encode(3, 1, 0, 1), TranslationFlags.HwaoiPrivateRegisters);
+            Reject(Encode(0, 1, 3, 1), TranslationFlags.HwaoiPrivateRegisters);
+            Reject(Encode(1, 1, 0, 1) ^ (1UL << 16), TranslationFlags.HwaoiPrivateRegisters);
+            Reject(Encode(1, 1, 0, 1) | (1UL << 39), TranslationFlags.HwaoiPrivateRegisters);
+            Check(!TryDecodeMove(0x5c98078000170000UL, TranslationFlags.None, out _, out _), "ordinary MOV changed");
+
+            // Test every live-mask boundary across all twelve 64-bit GPR masks.
+            int[] boundaries = {0, 63, 64, 127, 128, 191, 192, 254, 256, 319, 320, 383,
+                                384, 447, 448, 511, 512, 575, 576, 639, 640, 703, 704, 767};
+            foreach (int index in boundaries)
+            {
+                BasicBlock block = new(0);
+                int output = (index + 128) % 768;
+                if (output == RegisterConsts.RegisterZeroIndex) output--;
+                block.Operations.AddLast(new Operation(Instruction.Copy, Register(output, RegisterType.Gpr),
+                                                       Register(index, RegisterType.Gpr)));
+                block.Operations.AddLast(new Operation(Instruction.Return, (Operand)null));
+                var usage = RegisterUsage.RunPass(new ControlFlowGraph(new[] {block}));
+                Check(usage.InArguments.Any(r => r.Type == RegisterType.Gpr && r.Index == index), "live input mask crossing");
+                Check(usage.OutArguments.Any(r => r.Type == RegisterType.Gpr && r.Index == output), $"live output mask crossing {index}->{output}");
+            }
+
+            BasicBlock entry = new(0), left = new(1), right = new(2), join = new(3);
+            entry.Next = left; entry.Branch = right; left.Branch = join; right.Branch = join;
+            entry.Operations.AddLast(new Operation(Instruction.BranchIfTrue, Label(), Register(0, RegisterType.Predicate)));
+            foreach ((BasicBlock block, int gpr, int predicate, int flag) in new[] {
+                (left, 0x111, 0, 0x333), (right, 0x222, 1, 0x444)})
+            {
+                block.Operations.AddLast(new Operation(Instruction.Copy, Register(511, RegisterType.Gpr), Const(gpr)));
+                block.Operations.AddLast(new Operation(Instruction.Copy, Register(0, RegisterType.Predicate), Const(predicate)));
+                block.Operations.AddLast(new Operation(Instruction.Copy, Register(0, RegisterType.Flag), Const(flag)));
+                block.Operations.AddLast(new Operation(Instruction.Branch, Label()));
+            }
+            Operation readGpr = new(Instruction.Copy, Register(767, RegisterType.Gpr), Register(511, RegisterType.Gpr));
+            Operation readPredicate = new(Instruction.Copy, Register(512, RegisterType.Gpr), Register(0, RegisterType.Predicate));
+            Operation readFlag = new(Instruction.Copy, Register(513, RegisterType.Gpr), Register(0, RegisterType.Flag));
+            join.Operations.AddLast(readGpr); join.Operations.AddLast(readPredicate); join.Operations.AddLast(readFlag);
+            join.Operations.AddLast(new Operation(Instruction.Return, (Operand)null));
+            ControlFlowGraph cfg = new(new[] {entry, left, right, join});
+            Dominance.FindDominators(cfg);
+            Dominance.FindDominanceFrontiers(cfg.Blocks);
+            Ssa.Rename(cfg.Blocks);
+            Check(join.Operations.OfType<PhiNode>().Count() == 3, "three distinct GPR/predicate/flag phis required");
+            HashSet<int> Values(Operation read)
+            {
+                if (read.GetSource(0).AsgOp is not PhiNode phi) throw new InvalidOperationException("expected SSA phi");
+                HashSet<int> values = new();
+                for (int i = 0; i < phi.SourcesCount; i++)
+                {
+                    if (phi.GetSource(i).AsgOp is not Operation definition || definition.Inst != Instruction.Copy ||
+                        definition.GetSource(0).Type != OperandType.Constant)
+                        throw new InvalidOperationException("unexpected SSA defining operation");
+                    values.Add(definition.GetSource(0).Value);
+                }
+                return values;
+            }
+            Check(Values(readGpr).SetEquals(new[] {0x111, 0x222}), "GPR511 phi was aliased");
+            Check(Values(readPredicate).SetEquals(new[] {0, 1}), "predicate phi was aliased");
+            Check(Values(readFlag).SetEquals(new[] {0x333, 0x444}), "flag phi was aliased");
+            Check(!ReferenceEquals(readGpr.GetSource(0), readPredicate.GetSource(0)), "SSA GPR and predicate share a slot");
+            return $"probe-hwaoi-ir-banks: passed ({checks} checks; RZ255, GPR511/767, 12 live masks, SSA phis)";
+        }
+    }
+}
